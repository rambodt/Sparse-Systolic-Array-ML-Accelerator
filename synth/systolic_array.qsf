# Quartus Settings File
# Sparse Systolic Array Matrix Accelerator
# Target: Intel Cyclone V GX 5CGXFC9E7F35C8
# (342 DSPs / 301K LEs -- required for 256-PE array)
# Note: 5CSEMA5F31C6 (DE1-SoC) has only 87 DSPs; LUT fallback bloats logic beyond its capacity.

set_global_assignment -name FAMILY "Cyclone V"
set_global_assignment -name DEVICE 5CGXFC9E7F35C8
set_global_assignment -name TOP_LEVEL_ENTITY accel_top
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files

# ── Source files ──────────────────────────────────────────────────────────────
# Order matters: instantiated modules must appear before their parents
set_global_assignment -name SYSTEMVERILOG_FILE ../source/pe.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../source/array_top.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../source/scratchpad.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../source/dma_ctrl.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../source/sparsity_unit.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../source/output_buffer.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../source/accel_top.sv

# ── Timing constraints ────────────────────────────────────────────────────────
set_global_assignment -name SDC_FILE systolic_array.sdc

# ── Synthesis settings ────────────────────────────────────────────────────────
# Allow Quartus to infer DSP blocks and BRAMs automatically
set_global_assignment -name AUTO_RAM_RECOGNITION ON
set_global_assignment -name AUTO_DSP_RECOGNITION ON

# Optimization: balanced area/speed (change to SPEED if timing fails)
set_global_assignment -name OPTIMIZATION_MODE "HIGH PERFORMANCE EFFORT"

# Full recompile on each run (safer for first-time synthesis)
set_global_assignment -name SMART_RECOMPILE OFF

# ── Fitter settings ───────────────────────────────────────────────────────────
set_global_assignment -name FITTER_EFFORT "AUTO FIT"
set_global_assignment -name SEED 1

# ── EDA simulation output (optional — for ModelSim netlist sim) ───────────────
set_global_assignment -name EDA_SIMULATION_TOOL "ModelSim-Altera (SystemVerilog)"
set_global_assignment -name EDA_OUTPUT_DATA_FORMAT "SYSTEMVERILOG HDL" -section_id eda_simulation

set_global_assignment -name LAST_QUARTUS_VERSION "17.0.0 Lite Edition"
set_global_assignment -name PARTITION_NETLIST_TYPE SOURCE -section_id Top
set_global_assignment -name PARTITION_FITTER_PRESERVATION_LEVEL PLACEMENT_AND_ROUTING -section_id Top
set_global_assignment -name PARTITION_COLOR 16764057 -section_id Top
set_global_assignment -name MIN_CORE_JUNCTION_TEMP 0
set_global_assignment -name MAX_CORE_JUNCTION_TEMP 85
set_global_assignment -name POWER_PRESET_COOLING_SOLUTION "23 MM HEAT SINK WITH 200 LFPM AIRFLOW"
set_global_assignment -name POWER_BOARD_THERMAL_MODEL "NONE (CONSERVATIVE)"
set_global_assignment -name TIMEQUEST_MULTICORNER_ANALYSIS ON
set_global_assignment -name NUM_PARALLEL_PROCESSORS ALL
set_instance_assignment -name PARTITION_HIERARCHY root_partition -to | -section_id Top